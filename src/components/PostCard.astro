---
import type { CollectionEntry } from 'astro:content';
import { assetPath } from '../lib/paths';
import { formatDate } from '../lib/format';
import { makeExcerpt } from '../lib/content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}posts/${post.id}/`;
const excerpt = post.data.excerpt || makeExcerpt(post.body ?? '', 96);
---

<article class="post-card glass">
  {post.data.cover && (
    <a class="cover" href={href} aria-hidden="true" tabindex="-1">
      <img src={assetPath(post.data.cover)} alt={post.data.title} loading="lazy" />
    </a>
  )}
  <div class="post-card-body">
    <div class="meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </div>
    <h3><a href={href}>{post.data.title}</a></h3>
    <p class="excerpt">{excerpt}</p>
    {post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map((tag) => (
          <a class="tag-chip" href={`${base}tags/${encodeURIComponent(tag)}/`}>{tag}</a>
        ))}
      </div>
    )}
  </div>
</article>
