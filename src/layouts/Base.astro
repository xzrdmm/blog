---
import { siteConfig } from '../lib/site';
import { assetPath } from '../lib/paths';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const pageDescription = description ?? siteConfig.bio;

const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname;
const normalize = (s: string) => (s.endsWith('/') && s.length > 1 ? s.slice(0, -1) : s);
const isActive = (href: string) => {
  const h = normalize(href);
  const c = normalize(here);
  return h === c || (h !== normalize(base) && c.startsWith(`${h}/`));
};

const navItems = [
  { href: `${base}`, label: '首页' },
  { href: `${base}chatter`, label: '说说' },
  { href: `${base}tags`, label: '标签' },
  { href: `${base}archive`, label: '归档' },
];

const particles = Array.from({ length: 14 }, (_, i) => ({
  left: (i * 37 + 11) % 100,
  size: 4 + ((i * 7) % 5),
  duration: 14 + ((i * 5) % 12),
  delay: ((i * 13) % 16) * -1,
  opacity: 0.3 + (i % 3) * 0.14,
  sway: (i % 2 ? 1 : -1) * (12 + ((i * 3) % 18)),
}));

const year = new Date().getFullYear();
const bgImage = siteConfig.bgImages[0];
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={assetPath('/favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#e8edff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0e24" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark = stored
            ? stored === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <div class="bg-scene" style={bgImage ? `--bg-img:url('${bgImage}')` : undefined} aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
      {particles.map((p) => (
        <span
          class="particle"
          style={`left:${p.left}%;--ps:${p.size}px;--pd:${p.duration}s;--pdelay:${p.delay}s;--po:${p.opacity};--sway:${p.sway}px`}
        ></span>
      ))}
    </div>

    <header class="nav glass">
      <a class="nav-brand" href={base}>{siteConfig.title}</a>
      <nav class="nav-links" aria-label="主导航">
        {navItems.map((item) => (
          <a class:list={['nav-link', { active: isActive(item.href) }]} href={item.href}>
            {item.label}
          </a>
        ))}
      </nav>
      <button class="btn icon-btn theme-toggle" id="theme-toggle" type="button" aria-label="切换深色/浅色主题">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="footer container">
      <div class="footer-glass glass">
        © {year} {siteConfig.title} · 基于 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 与
        <a href="https://keystatic.com" target="_blank" rel="noopener"> Keystatic</a>
        {!import.meta.env.PROD && <>· <a href={`${base}keystatic`}>管理后台</a></>}
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
