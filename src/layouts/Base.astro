---
import { siteConfig } from '../lib/site';
import { assetPath } from '../lib/paths';
import { ViewTransitions } from 'astro:transitions';
import ScrollProgress from '../components/widgets/ScrollProgress.tsx';
import BackToTop from '../components/widgets/BackToTop.tsx';
import FloatingClock from '../components/widgets/FloatingClock.tsx';
import SearchButton from '../components/widgets/SearchButton.tsx';
import MiniPlayer from '../components/music/MiniPlayer.tsx';
import AudioHost from '../components/music/AudioHost.tsx';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.title}` : siteConfig.title;
const pageDescription = description ?? siteConfig.bio;
const absolute = (path: string) => new URL(assetPath(path), Astro.site).href;
const pageImage = image ? absolute(image) : absolute(siteConfig.avatar);

const base = import.meta.env.BASE_URL;
const here = Astro.url.pathname;
const normalize = (s: string) => (s.endsWith('/') && s.length > 1 ? s.slice(0, -1) : s);
const isActive = (href: string) => {
  const h = normalize(href);
  const c = normalize(here);
  return h === c || (h !== normalize(base) && c.startsWith(`${h}/`));
};

const navItems = [
  { href: `${base}`, label: '首页' },
  { href: `${base}music`, label: '音乐' },
  { href: `${base}chatter`, label: '说说' },
  { href: `${base}tags`, label: '标签' },
  { href: `${base}archive`, label: '归档' },
  { href: `${base}about`, label: '关于' },
  { href: `${base}friends`, label: '友链' },
  { href: `${base}photowall`, label: '照片墙' },
];

const particles = Array.from({ length: 26 }, (_, i) => ({
  left: (i * 37 + 11) % 100,
  size: 8 + ((i * 7) % 9),
  duration: 12 + ((i * 5) % 12),
  delay: ((i * 13) % 16) * -1,
  opacity: 0.35 + (i % 4) * 0.15,
  sway: (i % 2 ? 1 : -1) * (12 + ((i * 3) % 18)),
}));

const year = new Date().getFullYear();
const bgImage = siteConfig.wallpaper || siteConfig.bgImages[0];
const bgOpacity = Number(siteConfig.wallpaperOpacity) || 0.4;
const bgStyle = bgImage
  ? `--bg-img:url('${assetPath(bgImage)}');--bg-opacity:${bgOpacity}`
  : undefined;
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={assetPath('/favicon.svg')} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={`${base}rss.xml`} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#e8edff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0e24" />
    {siteConfig.goatcounterSite && (
      <script
        is:inline
        data-goatcounter={`https://${siteConfig.goatcounterSite}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
    <ViewTransitions />
    {import.meta.env.PROD && (
      <script is:inline data-base={base}>
        const swBase = document.currentScript?.getAttribute('data-base') ?? '/';
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register(`${swBase}sw.js`, { scope: swBase }).catch(() => {});
        }
      </script>
    )}
    <script is:inline>
      const applyTheme = () => {
        try {
          const stored = localStorage.getItem('theme');
          // 默认深色模式，除非用户显式切换过
          const dark = stored ? stored === 'dark' : true;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      };
      // 首次加载与 View Transitions 切换后都应用主题
      document.addEventListener('astro:page-load', applyTheme);
      applyTheme();
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteConfig.title,
      description: siteConfig.bio,
      url: Astro.url.origin,
    })}></script>
  </head>
  <body>
    <div class="bg-scene" style={bgStyle} aria-hidden="true">
      {siteConfig.enableAurora && (
        <>
          <div class="blob blob-1"></div>
          <div class="blob blob-2"></div>
          <div class="blob blob-3"></div>
        </>
      )}
      {siteConfig.enableParticles &&
        particles.map((p) => (
          <span
            class="particle"
            style={`left:${p.left}%;--ps:${p.size}px;--pd:${p.duration}s;--pdelay:${p.delay}s;--po:${p.opacity};--sway:${p.sway}px`}
          ></span>
        ))}
    </div>

    <header class="nav glass">
      <a class="nav-brand" href={base}>{siteConfig.title}</a>
      <nav class="nav-links" aria-label="主导航">
        {navItems.map((item) => (
          <a class:list={['nav-link', { active: isActive(item.href) }]} href={item.href}>
            {item.label}
          </a>
        ))}
      </nav>
      <button class="btn icon-btn theme-toggle" id="theme-toggle" type="button" aria-label="切换深色/浅色主题">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="footer container">
      <div class="footer-glass glass">
        © {year} {siteConfig.title} · 基于 <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> 与
        <a href="https://keystatic.com" target="_blank" rel="noopener"> Keystatic</a>
        {!import.meta.env.PROD && <>· <a href={`${base}keystatic`}>管理后台</a></>}
      </div>
    </footer>

    <AudioHost client:load transition:persist />
    <ScrollProgress client:load />
    <BackToTop client:load />
    <FloatingClock client:load />
    <SearchButton client:load base={base} />
    <MiniPlayer client:load transition:persist />

    <script is:inline data-base={base}>
      // 全局快捷键：/ 打开搜索
      const searchBase = document.currentScript?.getAttribute('data-base') ?? '/';
      document.addEventListener('keydown', (event) => {
        if (
          event.key === '/' &&
          !(event.target instanceof HTMLInputElement) &&
          !(event.target instanceof HTMLTextAreaElement) &&
          !location.pathname.endsWith('/search')
        ) {
          event.preventDefault();
          location.href = `${searchBase}search`;
        }
      });
    </script>

    <script is:inline>
      // 代码块：语言标签 + 复制按钮
      const enhanceCodeBlocks = () => {
        document.querySelectorAll('.prose pre').forEach((pre) => {
          if (pre.dataset.enhanced) return;
          pre.dataset.enhanced = '1';
          const code = pre.querySelector('code');
          const lang = code?.className.match(/language-([\w+-]+)/)?.[1] ?? '';
          const bar = document.createElement('div');
          bar.className = 'code-bar';
          const label = document.createElement('span');
          label.textContent = lang ? lang.toUpperCase() : 'CODE';
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy';
          btn.textContent = '复制';
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(code?.innerText ?? '');
              btn.textContent = '已复制 ✓';
              setTimeout(() => (btn.textContent = '复制'), 1500);
            } catch {
              btn.textContent = '复制失败';
            }
          });
          bar.append(label, btn);
          pre.prepend(bar);
        });
      };

      // 图片灯箱
      document.addEventListener('click', (event) => {
        const img = event.target?.closest?.('.prose img');
        if (!img) return;
        const overlay = document.createElement('div');
        overlay.className = 'lightbox';
        const clone = img.cloneNode(true);
        overlay.appendChild(clone);
        overlay.addEventListener('click', () => overlay.remove());
        document.body.appendChild(overlay);
      });

      const runEnhance = () => enhanceCodeBlocks();
      document.addEventListener('astro:page-load', runEnhance);
      if (document.readyState !== 'loading') runEnhance();
      else document.addEventListener('DOMContentLoaded', runEnhance);
    </script>

    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
