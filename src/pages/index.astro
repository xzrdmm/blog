---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProfileCard from '../components/ProfileCard.astro';
import ChatterCard from '../components/ChatterCard.astro';
import Carousel from '../components/Carousel.astro';
import HeroPanel from '../components/home/HeroPanel.tsx';
import HomeMusicSection from '../components/home/HomeMusicSection.tsx';
import HomeMasonry from '../components/home/HomeMasonry.tsx';
import { filterPublished, sortByDateDesc, sortPosts } from '../lib/posts';
import {
  curateFeaturedPosts,
  curateFeaturedProjects,
  curateFeaturedSongs,
  interleaveMasonry,
} from '../lib/homepage';
import { assetPath } from '../lib/paths';
import { makeExcerpt } from '../lib/content';
import { siteConfig } from '../lib/site';

const posts = sortPosts(filterPublished(await getCollection('posts')));
const chatters = sortByDateDesc(await getCollection('chatters'));
const songs = (await getCollection('songs')).filter((song) => !song.data.draft);
const projects = (await getCollection('projects')).filter((project) => !project.data.draft);
const base = import.meta.env.BASE_URL;

// 主页歌单：全部已发布歌曲用于播放器；精选歌曲用于音乐板块
const heroSongProps = songs.map((song) => ({
  id: song.id,
  title: song.data.title,
  artist: song.data.artist,
  playlist: song.data.playlist,
  cover: song.data.cover ? assetPath(song.data.cover) : undefined,
  audio: song.data.audio ? assetPath(song.data.audio) : undefined,
  lyrics: song.data.lyrics ? assetPath(song.data.lyrics) : undefined,
  lyricsText: song.data.lyricsText,
}));

const featuredSongs = curateFeaturedSongs(songs, siteConfig.featuredSongs, 6);
const musicSectionSongs = featuredSongs.map((song) => ({
  id: song.id,
  title: song.data.title,
  artist: song.data.artist,
  playlist: song.data.playlist,
  cover: song.data.cover ? assetPath(song.data.cover) : undefined,
  audio: song.data.audio ? assetPath(song.data.audio) : undefined,
  lyrics: song.data.lyrics ? assetPath(song.data.lyrics) : undefined,
  lyricsText: song.data.lyricsText,
  rating: song.data.rating,
  review: song.data.review,
}));

// 灵感与作品：后台可配置展示哪些文章/项目，默认取最新；文章与项目均匀交错（共 4-6 个）
const postItems = curateFeaturedPosts(posts, siteConfig.featuredPosts, 4).map((post) => ({
  kind: 'post' as const,
  id: post.id,
  title: post.data.title,
  date: post.data.date.toISOString(),
  excerpt: post.data.excerpt || makeExcerpt(post.body ?? '', 96),
  cover: post.data.cover ? assetPath(post.data.cover) : undefined,
  tags: post.data.tags,
}));
const projectItems = curateFeaturedProjects(projects, siteConfig.featuredProjects, 2).map((project) => ({
  kind: 'project' as const,
  id: project.id,
  title: project.data.title,
  description: project.data.description,
  cover: project.data.cover ? assetPath(project.data.cover) : undefined,
  link: project.data.link || undefined,
  tags: project.data.tags,
}));
const masonryItems = interleaveMasonry(postItems, projectItems, 6);
---

<Base>
  <section class="hero">
    <ProfileCard />
    <HeroPanel client:load songs={heroSongProps} />
  </section>

  {chatters.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>最新说说</h2>
        <a class="section-more" href={`${base}chatter/`}>查看全部 →</a>
      </div>
      <Carousel>
        {chatters.map((chatter) => <ChatterCard chatter={chatter} />)}
      </Carousel>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>灵感与作品</h2>
      <a class="section-more" href={`${base}archive/`}>归档 →</a>
    </div>
    {masonryItems.length > 0 ? (
      <HomeMasonry client:load items={masonryItems} base={base} />
    ) : (
      <p class="empty">还没有内容，去后台写第一篇吧。</p>
    )}
  </section>

  {musicSectionSongs.length > 0 && (
    <section class="section">
      <div class="section-head">
        <h2>音乐</h2>
        <a class="section-more" href={`${base}music/`}>查看全部 →</a>
      </div>
      <HomeMusicSection client:load songs={musicSectionSongs} />
    </section>
  )}
</Base>
