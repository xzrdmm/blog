---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleBrowser from '../../components/articles/ArticleBrowser.tsx';
import { filterPublished, sortPosts } from '../../lib/posts';
import { assetPath } from '../../lib/paths';
import { makeExcerpt } from '../../lib/content';

const posts = sortPosts(filterPublished(await getCollection('posts')));
const base = import.meta.env.BASE_URL;
const postItems = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  date: post.data.date.toISOString(),
  excerpt: post.data.excerpt || makeExcerpt(post.body ?? '', 96),
  cover: post.data.cover ? assetPath(post.data.cover) : undefined,
  tags: post.data.tags,
}));
---

<Base title="文章">
  <header class="page-header glass">
    <h1>文章</h1>
    <p>共 {posts.length} 篇文章，点标签即可筛选</p>
  </header>
  {posts.length > 0 ? (
    <ArticleBrowser client:load posts={postItems} base={base} />
  ) : (
    <p class="empty">还没有文章，去后台写第一篇吧。</p>
  )}
</Base>
