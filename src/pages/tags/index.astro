---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { collectTags, filterPublished, sortByDateDesc } from '../../lib/posts';

const posts = sortByDateDesc(filterPublished(await getCollection('posts')));
const tags = collectTags(posts);
const base = import.meta.env.BASE_URL;
---

<Base title="标签">
  <header class="page-header glass">
    <h1>标签</h1>
    <p>共 {tags.length} 个标签</p>
  </header>
  {tags.length > 0 ? (
    <div class="tag-cloud">
      {tags.map(({ tag, count }) => (
        <a class="tag-chip" href={`${base}tags/${encodeURIComponent(tag)}/`}>
          {tag}<span class="count">{count}</span>
        </a>
      ))}
    </div>
  ) : (
    <p class="empty">还没有标签。</p>
  )}
</Base>
